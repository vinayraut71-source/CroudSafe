# Copy to .env and replace values only when outbound notifications are needed.
# Empty credentials are supported; SMS and email delivery is simulated when unset.

# Optional Twilio SMS notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_PHONES=

# Optional SMTP email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAILS=

# Optional webhook notifications
WEBHOOK_URL=

# Gemini Multimodal Crowd Intelligence Platform
# Paste your Google Gemini API key here:
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
